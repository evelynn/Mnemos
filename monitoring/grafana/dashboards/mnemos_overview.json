{
  "title": "Mnemos Overview",
  "uid": "mnemos-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP traffic (rps, by status bucket)",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (status) (rate(mnemos_http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (5xx, per minute)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(mnemos_http_requests_total{status=\"5xx\"}[1m]))",
          "legendFormat": "5xx rps"
        }
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency (p50 / p95 / p99, seconds)",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(mnemos_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(mnemos_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(mnemos_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99"}
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Rate limiter rejections (last 1h)",
      "gridPos": {"x": 12, "y": 8, "w": 6, "h": 8},
      "targets": [
        {"expr": "sum(increase(mnemos_rate_limited_total[1h]))"}
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Analysis runs completed (last 24h)",
      "gridPos": {"x": 18, "y": 8, "w": 6, "h": 8},
      "targets": [
        {"expr": "sum by (status) (increase(mnemos_analysis_runs_total[24h]))", "legendFormat": "{{status}}"}
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Webhook → ARQ ingest lag (p50/p95, sec)",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "description": "Time between receiving a GitLab push event and the analyzer subprocess starting. Watches PR-3's `_defer_by` plus queue depth.",
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (le) (rate(mnemos_ingest_lag_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(mnemos_ingest_lag_seconds_bucket[5m])))", "legendFormat": "p95"}
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 7,
      "type": "stat",
      "title": "ProjectDBs disabled by re-probe (24h)",
      "gridPos": {"x": 12, "y": 16, "w": 6, "h": 8},
      "description": "PR-4 daily probe sweep marks bindings whose credentials lost their read-only character.",
      "targets": [
        {"expr": "max(mnemos_project_db_disabled_total)"}
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Cron advisory-lock contention (1h)",
      "gridPos": {"x": 18, "y": 16, "w": 6, "h": 8},
      "description": "How often a worker tried to run a cron entry and lost the pg_try_advisory_lock race. Sustained non-zero values mean the multi-worker leader story is working as intended.",
      "targets": [
        {"expr": "sum(increase(mnemos_cron_lock_lost_total[1h]))"}
      ],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    }
  ]
}
