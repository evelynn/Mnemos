# Copy to `.env`; REQUIRED/HIGH/OPTIONAL/DEV labels describe priority.

# ─── REQUIRED ──────────────────────────────────────────────────

# PostgreSQL container settings.
POSTGRES_USER=mnemos
POSTGRES_PASSWORD=mnemos
POSTGRES_DB=mnemos
POSTGRES_PORT=5432

REDIS_PORT=6379

PLATFORM_PORT=8080

# [REQUIRED] Session cookie signer. PR-97 — platform refuses to boot
# in production if this is left at the placeholder. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-to-a-random-32-byte-secret

# [REQUIRED] KMS data-encryption key for secrets-at-rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# [REQUIRED] production / staging / test; production rejects placeholder keys.
MNEMOS_ENV=production

# [REQUIRED] SQLAlchemy URL:
#   postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://mnemos:mnemos@postgres:5432/mnemos

# ─── HIGH (production deploy) ──────────────────────────────────

# Log verbosity.
LOG_LEVEL=INFO

# [HIGH] Tenant-bound OTLP map: {"<org UUID>":"<unique 32+ char token>"}.
# Missing, malformed, duplicate, or ambiguous configuration rejects traffic.
MNEMOS_OTLP_ORG_TOKENS=
# Legacy single-tenant pair; set both only when the map is empty.
MNEMOS_OTLP_TOKEN=
MNEMOS_OTLP_ORGANIZATION_ID=

# [HIGH] Bearer token for /metrics. Empty = open (only use when
# reverse-proxy restricts /metrics). Production should set this.
METRICS_BEARER_TOKEN=

# [HIGH] MCP server bearer token for Claude Code's stdio transport.
MNEMOS_MCP_TOKEN=

# [HIGH] P1-finding webhook; empty disables notifications.
NOTIFY_WEBHOOK_URL=
# Public base URL for finding links.
NOTIFY_LINK_BASE=

# [HIGH] OIDC / SSO (PR-43, PR-130 nonce). Leave blank for local-auth-only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile

# [OPTIONAL] L1–L3 narration; indexing remains zero-token.
ANTHROPIC_API_KEY=

# [HIGH] Webhook mirror at <root>/<project_uuid>[.git] containing the push SHA.
SOURCE_MIRROR_ROOT=
# Empty worktree root defaults to <SOURCE_MIRROR_ROOT>/.mnemos-worktrees.
SOURCE_WORKTREE_ROOT=
# Manual-analysis root; empty disables manual analysis.
SOURCE_ALLOWED_ROOT=
# [REQUIRED for manual analysis] Project UUID -> relative root JSON; e.g.
# {"<project UUID>":"."}. Missing or invalid bindings fail closed.
SOURCE_PROJECT_ROOTS=

# ─── OPTIONAL ──────────────────────────────────────────────────

# [OPTIONAL] KMS backend: "local" (env FERNET_KEY) or "vault".
KMS_BACKEND=local
KMS_KEY_ARN=

# HSTS seconds (0 disables); optional CSP override.
MNEMOS_HSTS_MAX_AGE=31536000
MNEMOS_CSP=

# Audit detail JSON cap (bytes).
MNEMOS_AUDIT_DETAILS_CAP=4096

# [OPTIONAL] Rate limit (PR-46). Both must be set together. Default
# 100 mutations / 60s window per user.
MNEMOS_GLOBAL_RATE_LIMIT=100
MNEMOS_GLOBAL_RATE_WINDOW=60

# [OPTIONAL] Stale analysis-run reaper threshold (cron). Default 24h.
MNEMOS_STALE_RUN_AFTER_SEC=86400

# [OPTIONAL] In-memory graph identities before private SQLite spillover.
MNEMOS_SEEN_MEMORY_LIMIT=100000

# [OPTIONAL] LLM cost rate ($/M-tokens).
MNEMOS_LLM_USD_PER_MTOK=3.00

# [OPTIONAL] Per-project rolling LLM budget; 0 disables the cap.
MNEMOS_LLM_BUDGET_USD_PER_PROJECT=0
MNEMOS_LLM_BUDGET_WINDOW_SEC=86400

# [OPTIONAL] Per-run agent/L1-L3 limits; never affect zero-token indexing.
MNEMOS_LLM_MAX_CALLS_PER_RUN=64
MNEMOS_LLM_MAX_INPUT_TOKENS_PER_RUN=120000
MNEMOS_LLM_WALL_TIME_SEC=600

# [OPTIONAL] Enable in-repo analyzers without Docker; empty/0 = off.
MNEMOS_INREPO_ANALYZERS=

# [OPTIONAL] Vector / embedding provider (PR-90). Empty = lexical only.
MNEMOS_EMBEDDING_PROVIDER=
MNEMOS_EMBEDDING_MODEL=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# [OPTIONAL] Set 1 to disable Claude Agent SDK (for example, air-gapped use).
MNEMOS_DISABLE_AGENT_SDK=

# [OPTIONAL] cwd for Claude Agent SDK subprocess. Defaults to /tmp.
MNEMOS_AGENT_SDK_CWD=

# [OPTIONAL] Chat source root and provider-specific model/credentials.
MNEMOS_CHAT_SOURCE_ROOT=
MNEMOS_CHAT_MODEL=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ATLAS_BASE_URL=
ATLAS_API_KEY=
ATLAS_AGENT_ID=

# [OPTIONAL] Voice input/STT; MNEMOS_DISABLE_STT disables it.
MNEMOS_DISABLE_STT=
MNEMOS_STT_ENGINE=
MNEMOS_STT_MODEL=
MNEMOS_STT_DEVICE=
MNEMOS_STT_COMPUTE=
MNEMOS_STT_LANGUAGE=
MNEMOS_STT_BEAM_SIZE=
MNEMOS_STT_MAX_UPLOAD_BYTES=

# [OPTIONAL] Voice output/TTS; absent dependencies hide playback controls.
MNEMOS_DISABLE_TTS=
MNEMOS_TTS_ENGINE=
MNEMOS_TTS_VOICE=
MNEMOS_TTS_LANG=
MNEMOS_TTS_SPEED=
MNEMOS_TTS_MAX_CHARS=

# ─── DEV ───────────────────────────────────────────────────────

# [DEV] Import without live services (CI tooling only; never production).
MNEMOS_SKIP_STARTUP_VERIFY=

# [DEV] Docker-free SQLite/fakeredis/inline mode; serve_local sets it.
MNEMOS_LOCAL_MODE=
