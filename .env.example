# ─── Mnemos .env.example ──────────────────────────────────────────
#
# Copy to `.env` and fill in. Variables fall into 4 tiers:
#   [REQUIRED]   — boot fails or platform is insecure without it
#   [HIGH]       — sane production deploy sets these
#   [OPTIONAL]   — feature flags / advanced tuning
#   [DEV]        — only for local development; don't ship to prod

# ─── REQUIRED ──────────────────────────────────────────────────

# PostgreSQL container env (used by docker-compose).
POSTGRES_USER=mnemos
POSTGRES_PASSWORD=mnemos
POSTGRES_DB=mnemos
POSTGRES_PORT=5432

# Redis container env.
REDIS_PORT=6379

# Platform server port.
PLATFORM_PORT=8080

# [REQUIRED] Session cookie signer. PR-97 — platform refuses to boot
# in production if this is left at the placeholder. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-to-a-random-32-byte-secret

# [REQUIRED] KMS data-encryption key for secrets-at-rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# [REQUIRED] production / staging / test — PR-97 SECRET_KEY guard
# only fires when this is "production".
MNEMOS_ENV=production

# [REQUIRED] SQLAlchemy connection URL. Format:
#   postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://mnemos:mnemos@postgres:5432/mnemos

# ─── HIGH (production deploy) ──────────────────────────────────

# Log verbosity. INFO is the prod-sane default.
LOG_LEVEL=INFO

# [HIGH] Bearer token for OpenTelemetry receiver. Empty = receiver
# rejects all OTLP traffic (fail-closed per PR-72).
MNEMOS_OTLP_TOKEN=

# [HIGH] Bearer token for /metrics. Empty = open (only use when
# reverse-proxy restricts /metrics). Production should set this.
METRICS_BEARER_TOKEN=

# [HIGH] MCP server bearer token for Claude Code's stdio transport.
MNEMOS_MCP_TOKEN=

# [HIGH] Outbound webhook for new P1 findings (PR-104). Slack
# incoming-webhook URL works directly. Empty = notifier disabled.
NOTIFY_WEBHOOK_URL=
# Public hostname for finding drilldown links inside notifications.
NOTIFY_LINK_BASE=

# [HIGH] OIDC / SSO (PR-43, PR-130 nonce). Leave blank for local-auth-only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile

# [HIGH] Anthropic API key for L1~L3 LLM summarisation.
# PR-125 — when running inside Claude Code, the agent SDK uses the
# operator's subscription and this var is optional. Set this for
# standalone production deploys.
ANTHROPIC_API_KEY=

# ─── OPTIONAL ──────────────────────────────────────────────────

# [OPTIONAL] KMS backend: "local" (env FERNET_KEY) or "vault".
KMS_BACKEND=local
KMS_KEY_ARN=

# [OPTIONAL] HSTS max-age in seconds. Default 31536000 (1y). 0 = no HSTS.
MNEMOS_HSTS_MAX_AGE=31536000

# [OPTIONAL] CSP override. Leave empty to use the locked-down default
# from app/security/headers.py.
MNEMOS_CSP=

# [OPTIONAL] Audit details JSONB cap (PR-101). Default 4096 bytes.
MNEMOS_AUDIT_DETAILS_CAP=4096

# [OPTIONAL] Rate limit (PR-46). Both must be set together. Default
# 100 mutations / 60s window per user.
MNEMOS_GLOBAL_RATE_LIMIT=100
MNEMOS_GLOBAL_RATE_WINDOW=60

# [OPTIONAL] Stale analysis-run reaper threshold (cron). Default 24h.
MNEMOS_STALE_RUN_AFTER_SEC=86400

# [OPTIONAL] LLM cost rate ($/M-tokens) for the dashboard's
# Operational Costs chart.
MNEMOS_LLM_USD_PER_MTOK=3.00

# [OPTIONAL] LLM spend guard (PR-138). Per-project budget cap in USD
# over a rolling window; the extractor falls back to the stub once a
# project exceeds it. 0 = disabled (no cap). Window default 86400 (24h).
MNEMOS_LLM_BUDGET_USD_PER_PROJECT=0
MNEMOS_LLM_BUDGET_WINDOW_SEC=86400

# [OPTIONAL] Run the pure-stdlib in-repo analyzers (ggoss-py) without
# Docker (PR-153). serve_local sets this to "1" so the basic config gets
# verified deterministic Python extraction; production uses the analyzer
# images on PATH and ignores it. Empty/0 = off (Claude-Code fallback).
MNEMOS_INREPO_ANALYZERS=

# [OPTIONAL] Vector / embedding provider (PR-90). Empty = lexical only.
MNEMOS_EMBEDDING_PROVIDER=
MNEMOS_EMBEDDING_MODEL=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# [OPTIONAL] Claude Agent SDK opt-out (PR-125). When set to "1" the
# extractor skips the SDK path even when claude-agent-sdk is
# installed — useful in air-gapped envs.
MNEMOS_DISABLE_AGENT_SDK=

# [OPTIONAL] cwd for Claude Agent SDK subprocess. Defaults to /tmp.
MNEMOS_AGENT_SDK_CWD=

# [OPTIONAL] Repo root the Chat tab (PR-174) reads source code from to
# enrich LLM answers. If unset, the chat falls back to graph facts only
# (no code excerpts). Per-request source_root overrides this.
MNEMOS_CHAT_SOURCE_ROOT=

# [OPTIONAL] Voice INPUT / STT, Ask tab (PR-155/156). Default engine
# Moonshine tiny-ko (pip install 'mnemos-platform[voice]'); for multilingual
# use [voice-whisper] + MNEMOS_STT_ENGINE=faster-whisper. Absent -> mic
# hides + 503. LANGUAGE picks the Moonshine flavor (default ko). DISABLE=off.
MNEMOS_DISABLE_STT=
MNEMOS_STT_ENGINE=
MNEMOS_STT_MODEL=
MNEMOS_STT_DEVICE=
MNEMOS_STT_COMPUTE=
MNEMOS_STT_LANGUAGE=
MNEMOS_STT_BEAM_SIZE=
MNEMOS_STT_MAX_UPLOAD_BYTES=

# [OPTIONAL] Voice OUTPUT / TTS — read answers aloud (PR-156) via Kokoro-82M
# (pip install 'mnemos-platform[tts]'). VOICE default af_heart (English; a
# kf_* voice = Korean); LANG derived from voice. Absent -> listen btn hides.
MNEMOS_DISABLE_TTS=
MNEMOS_TTS_ENGINE=
MNEMOS_TTS_VOICE=
MNEMOS_TTS_LANG=
MNEMOS_TTS_SPEED=
MNEMOS_TTS_MAX_CHARS=

# ─── DEV ───────────────────────────────────────────────────────

# [DEV] Set to "1" only for tooling that imports app without a live
# env (CI OpenAPI gen). Production must NOT set this.
MNEMOS_SKIP_STARTUP_VERIFY=

# [DEV] Docker-free local mode (PR-135): SQLite + in-process fakeredis
# + inline jobs, no external services. ``python -m app.serve_local``
# sets this for you. Auto-detected anyway when DATABASE_URL is SQLite.
MNEMOS_LOCAL_MODE=
